{
  "source": {
    "kind": "http",
    "url": "https://api.wikimedia.org/feed/v1/wikipedia/en/onthisday/events/{{config.month}}/{{config.day}}",
    "intervalMs": 21600000
  },
  "select": "events",
  "view": {
    "type": "list",
    "row": {
      "left": "{{item.year}}",
      "title": "{{item.text}}",
      "right": "{{config.month}}/{{config.day}}",
      "openUrl": "{{item.pages.0.content_urls.desktop.page}}"
    },
    "emptyText": "No events for this date."
  }
}
