{
  "source": {
    "kind": "http",
    "url": "https://api.github.com/search/issues?q=is%3Aopen%20is%3Apr%20review-requested%3A{{config.user}}%20archived%3Afalse&per_page=30",
    "headers": {
      "Authorization": "Bearer {{secret.github_pat}}",
      "Accept": "application/vnd.github+json",
      "User-Agent": "2ndMonitorHub-Tile/1.0"
    },
    "intervalMs": 300000
  },
  "select": "items",
  "view": {
    "type": "list",
    "row": {
      "left": "#{{item.number}}",
      "title": "{{item.title}}",
      "right": "{{item.user.login}}",
      "openUrl": "{{item.html_url}}"
    },
    "emptyText": "No PRs awaiting your review."
  }
}
