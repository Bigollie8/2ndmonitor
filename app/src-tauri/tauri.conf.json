{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second-Monitor Hub",
  "version": "0.4.0",
  "identifier": "com.secondmonitor.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Second-Monitor Hub",
        "width": 1920,
        "height": 1080,
        "minWidth": 960,
        "minHeight": 540,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: ws: http: ",
        "media-src": "'self' https:",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/seed/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {}
}
