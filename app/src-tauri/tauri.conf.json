{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second-Monitor Hub",
  "version": "0.9.11",
  "identifier": "com.secondmonitor.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Second-Monitor Hub",
        "width": 1920,
        "height": 1080,
        "minWidth": 960,
        "minHeight": 540,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: ws: http: ",
        "media-src": "'self' https:",
        "object-src": "'none'",
        "frame-src": "http://vizsandbox.localhost vizsandbox://localhost"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Bigollie8",
    "copyright": "Copyright (c) 2026 Bigollie8. Licensed under the Business Source License 1.1.",
    "licenseFile": "resources/legal/LICENSE.txt",
    "shortDescription": "Second-Monitor Hub",
    "longDescription": "A dashboard and music visualiser for a second monitor: configurable tiles, audio-reactive visualisers, MilkDrop presets, and a bundle marketplace.",
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/icon.ico", "icons/icon.icns"],
    "resources": ["resources/seed/**/*", "resources/legal/*"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.2"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0Q0RENjVENEFEQTVENEYKUldSUFhkcEtYZGJOWkV0bUJyRFIzZ0U4aXMvQTU5a21lMHQ0VHcxSmxqY3QzZDNYWHNGWXFLZW8K",
      "endpoints": [
        "https://github.com/Bigollie8/2ndmonitor-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
